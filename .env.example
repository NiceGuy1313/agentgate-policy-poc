# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM used by the TaskSpec extractor (Stage 4) and the judge (Stage 7) ---
AGENTGATE_LLM_PROVIDER=anthropic          # anthropic | openai
AGENTGATE_LLM_MODEL=claude-sonnet-5-5
AGENTGATE_JUDGE_MODEL=                    # optional, defaults to AGENTGATE_LLM_MODEL

# --- agent model for live evaluation (Stage 6/7) ---
AGENTGATE_AGENT_PROVIDER=anthropic        # anthropic | openai
AGENTGATE_AGENT_MODEL=claude-sonnet-5-5

# --- provider keys (only the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
