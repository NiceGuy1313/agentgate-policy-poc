# Copy to .env (git-ignored) or set the same names as environment variables in the cloud environment
# settings. Real environment variables take precedence over .env. Never commit real keys.

# --- TaskSpec extractor ---
# Cached extractions in data/<v1|v3>/cache/taskspec/<model>/ are reused without any key.
AGENTGATE_LLM_PROVIDER=anthropic          # anthropic | ollama | openai
AGENTGATE_LLM_MODEL=claude-haiku-5-5        # spec extraction (TaskSpec, v3 ToolSpec below) runs on Haiku
AGENTGATE_LLM_EFFORT=medium               # anthropic only
AGENTGATE_LLM_FALLBACKS=default           # anthropic only; "off" to disable

# --- judge (C4 v1, C10a v3) ---
# The v3 judge (Trusted LLM) runs on the same model as the agent: leave these empty and it follows
# AGENTGATE_AGENT_PROVIDER / _MODEL / _THINK below (e.g. ollama + gpt-oss:120b via Ollama Cloud). Set them only to
# run the judge on another model. Never leave a claude-* model here while the agent runs on ollama (v3 refuses to start).
AGENTGATE_JUDGE_PROVIDER=                 # empty: v3 = AGENTGATE_AGENT_PROVIDER; v1 = AGENTGATE_LLM_PROVIDER
AGENTGATE_JUDGE_MODEL=                    # empty: v3 = AGENTGATE_AGENT_MODEL; v1 = AGENTGATE_LLM_MODEL
AGENTGATE_JUDGE_THINK=                    # v3, ollama only: true | false | low | medium | high (empty = AGENTGATE_AGENT_THINK)

# --- v3 ToolSpec extractor (C6/C7/C7n/C8), anthropic ---
AGENTGATE_TOOLSPEC_MODEL=claude-haiku-5-5

# --- agent under test (live evaluation) ---
AGENTGATE_AGENT_PROVIDER=anthropic        # anthropic | ollama | openai
AGENTGATE_AGENT_MODEL=claude-sonnet-5-5   # for ollama: a name from GET {OLLAMA_HOST}/api/tags (no ":cloud" suffix)
AGENTGATE_AGENT_EFFORT=medium             # anthropic only
AGENTGATE_AGENT_THINK=                    # ollama only: true | false | low | medium | high (empty = model default)

# --- keys / hosts ---
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=                           # Ollama Cloud key (https://ollama.com); not needed for a local server
OLLAMA_HOST=https://ollama.com            # or http://localhost:11434
OPENAI_API_KEY=
