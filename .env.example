# Copy to .env (git-ignored) or set the same names as environment variables in the cloud environment
# settings. Real environment variables take precedence over .env. Never commit real keys.

# --- provider key (required) ---
ANTHROPIC_API_KEY=

# --- TaskSpec extractor (Stage 4) and escalation judge (Stage 7) ---
AGENTGATE_LLM_PROVIDER=anthropic
AGENTGATE_LLM_MODEL=claude-sonnet-5-5     # default if unset
AGENTGATE_LLM_EFFORT=medium               # low | medium | high | xhigh | max (Sonnet 5.5 default: high; medium recommended for multistep tool use)
AGENTGATE_LLM_FALLBACKS=default           # server-side refusal fallback; "off" to disable
AGENTGATE_JUDGE_MODEL=                    # optional, defaults to AGENTGATE_LLM_MODEL

# --- agent under test (Stage 6/7 live evaluation) ---
AGENTGATE_AGENT_PROVIDER=anthropic
AGENTGATE_AGENT_MODEL=claude-sonnet-5-5   # default if unset; no fallback (the evaluated model must stay fixed)
AGENTGATE_AGENT_EFFORT=medium

# --- optional, only if the environment's network policy allows api.openai.com ---
OPENAI_API_KEY=
