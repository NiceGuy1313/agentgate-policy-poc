# 쓰는 것만 채우세요. Observatory(run.py)를 Claude 모델로 돌릴 때는 로그인된 Claude Code를 쓰므로 키가 없어도 됩니다.
#   cp observatory/.env.example observatory/.env
#   set -a; source observatory/.env; set +a

# Anthropic SDK를 쓰는 에이전트 (예: 시험용 toy agent)
ANTHROPIC_API_KEY=

# OpenAI SDK, 또는 litellm으로 OpenAI 모델을 쓰는 에이전트
OPENAI_API_KEY=

# DeepInfra: 로그 연결을 다른 LLM으로 할 때 litellm 프록시가 쓰고(README의 "다른 LLM으로 실행"),
# litellm으로 DeepInfra 모델을 쓰는 에이전트도 씁니다 (예: mini-swe-agent -m deepinfra/Qwen/Qwen3.8-27B)
DEEPINFRA_API_KEY=
