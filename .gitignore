# Python
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets (keep the template)
.env
.env.*
!.env.example

# Claude Code / agent tooling: CLAUDE.md and .claude/settings.json are committed for cloud sessions
CLAUDE.local.md
AGENTS.md
.claude/*
!.claude/settings.json
.omc/
.mcp.json

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Run artefacts
logs/
# Raw live-run directories; each run is committed as runs.tar.gz instead
results/v*/live/*/C[0-9]/
results/v*/live/*/C[0-9]n/

# Dashboard run history (inspection only)
dashboard/runs/

# LLM response caches (data/<version>/cache/<kind>/<model>/): only the v1 model behind the report
# (claude-sonnet-5-5) is committed; caches of other models people try locally stay out of git
data/v1/cache/*/*/
!data/v1/cache/*/claude-sonnet-5-5/

# Stray logs from local runs
*.log
nohup.out

# v2 detector score cache (regenerable)
data/v2/cache/detector/
# Hugging Face model downloads when HF_HOME points inside the repo
.hf_cache/
