# Python
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets (keep the template)
.env
.env.*
!.env.example

# Claude Code / agent tooling (local only)
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
.omc/
.mcp.json

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Run artefacts
logs/
# Raw live-run directories; each run is committed as runs.tar.gz instead
results/live/*/*/C[0-9]/

# Dashboard run history (inspection only)
dashboard/runs/

# LLM response caches: only the model behind the report (claude-sonnet-5-5) is committed;
# caches from other models that people try locally stay out of git
data/judge_cache/*/
!data/judge_cache/claude-sonnet-5-5/
data/specs/llm_cache/*/
!data/specs/llm_cache/claude-sonnet-5-5/

# Stray logs from local runs
*.log
nohup.out
